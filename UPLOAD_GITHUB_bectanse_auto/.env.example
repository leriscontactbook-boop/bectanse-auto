# Core web application
SECRET_KEY=
DATA_ENCRYPTION_KEY=
DATABASE_URL=postgresql://user:password@host:5432/database
BOT_TOKEN=
ADMIN_ID=
ADMIN_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PORT=8080

# Automatic MT5 journal — API / Railway
APP_ENV=development
TRADING_PROVIDER=mock
# Generate with: python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
MT5_CREDENTIAL_MASTER_KEY=
# Generate a different value with at least 32 random characters.
INTERNAL_WORKER_SECRET=
MT5_SYNC_INTERVAL_SECONDS=300
MT5_SYNC_OVERLAP_SECONDS=900
MT5_MANUAL_SYNC_COOLDOWN_SECONDS=60
MT5_DAILY_RECONCILIATION_DAYS=7
MT5_WEEKLY_RECONCILIATION_DAYS=90
MT5_JOB_LEASE_SECONDS=300
MT5_CIRCUIT_FAILURE_THRESHOLD=50
MT5_CREDENTIAL_KEY_VERSION=1
MT5_REQUIRE_READ_ONLY=true

# Automatic MT5 journal — Windows worker only
BACKEND_URL=https://acces.bectanse-academie.com
WORKER_ID=MT5-WORKER-NODE-01
MT5_WORKER_COUNT=1
WORKER_SLOT_COUNT=1
MAX_CONCURRENT_MT5_SESSIONS=1
MT5_TERMINAL_PATHS=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_CONNECT_TIMEOUT_MS=45000
MT5_WORKER_POLL_SECONDS=5
LOG_LEVEL=INFO

# Billing (prefer a least-privilege restricted key in the hosting secret vault)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENT_SUCCESS_URL=
STRIPE_ACADEMY_PORTAL_CONFIGURATION=
STRIPE_JOURNAL_PRO_PRICE_ID=
STRIPE_JOURNAL_ELITE_PRICE_ID=

# Optional services already supported by the application
OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL=gpt-5.6-luna
ANALYSIS_INITIAL_CREDITS=2
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
BREVO_KEY=
BREVO_MEMBERS_LIST_ID=
BREVO_PROSPECTS_LIST_ID=
BREVO_WEBHOOK_SECRET=
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
CLOUDINARY_CLOUD=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
CANAL_BOT_TOKEN=
